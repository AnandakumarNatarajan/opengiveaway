# OpenGiveaway multi-tenant server (`opengiveaway host`) configuration.
# Copy to `.env` and fill in. Never commit real keys.

# Supabase project (Cloud or self-hosted). The frontend receives ONLY the URL
# and the anon key (via /config.js); the service-role key stays on the server.
SUPABASE_URL=https://YOUR-PROJECT.supabase.co
SUPABASE_ANON_KEY=your-anon-key

# Optional. Only needed if a future server-side admin op requires elevation.
# Do NOT expose this to the browser.
SUPABASE_SERVICE_ROLE_KEY=

# Bitcoin block-hash source (Esplora-compatible).
BITCOIN_PROVIDER_URL=https://mempool.space/api

# HTTP port for the server.
PORT=8080
